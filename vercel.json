{
  "cleanUrls": true,
  "headers": [
    { "source": "/(img|audio|fonts)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }] },
    { "source": "/(js|css|ds)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
